GEMINI_API_KEY=your_google_gemini_api_key
SERPAPI_API_KEY=your_serpapi_key

# Optional. Defaults to models/gemini-flash-latest.
# Pin a specific model here if you need reproducible runs, e.g.
# GEMINI_MODEL=models/gemini-2.5-flash

# Optional. Search locale, defaults to en/us. Set these for non-English
# questions, or Google returns US English results regardless.
# SEARCH_LANG=fr
# SEARCH_COUNTRY=fr
